{
  "name": "car-sound-mod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android:build": "powershell -NoProfile -File scripts/android.ps1",
    "android:run": "powershell -NoProfile -File scripts/android.ps1 -Install",
    "companion:build": "powershell -Command \"$env:JAVA_HOME = 'C:/Users/disha/Documents/CODES/studio/fileMAN/file-explorer-android/.jdk/jdk-17.0.20.1+1'; cd companion; .\\gradlew.bat assembleDebug --console plain\"",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "cockpit": "node scripts/launch-cockpit.js",
    "cockpit:kiosk": "node scripts/launch-cockpit.js --kiosk",
    "emulator": "node scripts/launch-emulator.js",
    "bridge": "node scripts/phone-bridge.js",
    "build": "vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0",
    "audit:lines": "node scripts/audit-monoliths.js",
    "gen:component": "node scripts/scaffold-component.js",
    "sim:feed": "node scripts/sim-telemetry.js",
    "apk:build": "node scripts/build-apk.js",
    "apk:run": "node scripts/build-apk.js --install",
    "dev:cockpit": "node scripts/dev-orchestrator.js",
    "hw:event": "node scripts/hw-event-injector.js",
    "bench:audio": "node --experimental-strip-types scripts/benchmark-audio.js",
    "doctor": "node scripts/doctor.js",
    "check:all": "node scripts/precommit-check.js",
    "check": "vue-tsc --noEmit",
    "lint": "eslint src eslint.config.js vite.config.ts --ext .ts,.vue",
    "format": "prettier --write src tests docs package.json tsconfig.json eslint.config.js vite.config.ts .github/workflows",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/google.maps": "^3.66.3",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0"
  }
}
